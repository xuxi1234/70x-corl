  "include": ["next-env.d.ts", ".next/types/**/*.ts", "app/**/*.tsx", "components/**/*.tsx", "lib/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx", "playwright.config.ts", "vitest.config.ts"]
}
